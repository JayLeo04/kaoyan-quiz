# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Published study material and generated knowledge assets are versioned because
# the hosted build needs the same source content as the local site.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Local-only working material. The README files in these directories document
# their intended use; all other contents stay out of version control.
/tmp/*
!/tmp/README.md
/source-materials/*
!/source-materials/README.md
