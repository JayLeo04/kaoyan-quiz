{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaoyanquiz.local/schemas/luna-exercise-question-1.json",
  "title": "LUNA exercise-book chapter question index",
  "description": "One chapter's derived question index. Markdown remains the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "book", "chapter", "source", "questions"],
  "properties": {
    "schemaVersion": { "const": "luna-exercise-question-1" },
    "book": { "$ref": "#/$defs/book" },
    "chapter": { "$ref": "#/$defs/chapter" },
    "source": { "$ref": "#/$defs/sourceRange" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "mode": { "const": "exercise-book" },
        "sourcePdf": { "type": "string", "minLength": 1 },
        "edition": { "type": "string" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title", "part", "questionMarkdown"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "number": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "part": { "type": "string", "enum": ["part-1-questions", "part-2-practice", "part-3-answers"] },
        "questionMarkdown": { "$ref": "#/$defs/relativeMarkdownPath" },
        "answerMarkdown": { "anyOf": [{ "$ref": "#/$defs/relativeMarkdownPath" }, { "type": "null" }] },
        "bookPages": { "$ref": "#/$defs/pageArray" },
        "pdfPages": { "$ref": "#/$defs/pageArray" }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdfPages", "bookPages"],
      "properties": {
        "pdfPages": { "$ref": "#/$defs/pageArray" },
        "bookPages": { "$ref": "#/$defs/pageArray" },
        "bookPageOffset": { "type": "integer" }
      }
    },
    "sourceBacklink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown", "anchor", "pdfPages", "bookPages"],
      "properties": {
        "markdown": { "$ref": "#/$defs/relativeMarkdownPath" },
        "anchor": { "type": "string", "pattern": "^\\S+$" },
        "pdfPages": { "$ref": "#/$defs/pageArray" },
        "bookPages": { "$ref": "#/$defs/pageArray" },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "number", "type", "chapterId", "section", "prompt", "options",
        "answer", "knowledgePoints", "images", "source", "review"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "number": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["choice", "true-false", "fill-blank", "short-answer", "calculation", "algorithm", "programming", "discussion", "practical", "unknown"]
        },
        "chapterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "section": { "$ref": "#/$defs/section" },
        "prompt": { "$ref": "#/$defs/markdownBlock" },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/markdownBlock" } },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "score": { "type": "number", "minimum": 0 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "unknown"] },
        "answer": { "$ref": "#/$defs/answer" },
        "knowledgePoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/knowledgePoint" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/image" }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "answer"],
          "properties": {
            "question": { "$ref": "#/$defs/sourceBacklink" },
            "answer": { "anyOf": [{ "$ref": "#/$defs/sourceBacklink" }, { "type": "null" }] }
          }
        },
        "review": { "$ref": "#/$defs/review" },
        "extensions": { "type": "object" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "markdownBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown"],
      "properties": {
        "markdown": { "type": "string", "minLength": 1 },
        "format": { "const": "markdown" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "markdown"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "origin", "original"],
      "properties": {
        "status": { "type": "string", "enum": ["provided", "hint-only", "missing", "pending-review"] },
        "origin": { "type": "string", "enum": ["book", "verified", "book+verified", "missing"] },
        "original": { "type": "string" },
        "verified": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "knowledgePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "relation", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_./-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "enum": ["primary", "secondary", "prerequisite", "application"] },
        "confidence": { "type": "string", "enum": ["confirmed", "candidate", "pending-review"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "alt", "role", "sourcePdfPages", "quality"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "path": { "type": "string", "pattern": "^assets/py/(?!.*(?:page-|screenshot|base64))[^\\s]+\\.(?:svg|png)$" },
        "alt": { "type": "string", "minLength": 4 },
        "role": { "type": "string", "enum": ["question", "answer", "explanation", "illustration"] },
        "sourcePdfPages": { "$ref": "#/$defs/pageArray" },
        "quality": { "$ref": "#/$defs/imageQuality" }
      }
    },
    "imageQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedBy", "format", "width", "height", "verified"],
      "properties": {
        "generatedBy": { "const": "python" },
        "format": { "type": "string", "enum": ["svg", "png"] },
        "width": { "type": "integer", "minimum": 1200 },
        "height": { "type": "integer", "minimum": 800 },
        "verified": { "const": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flags"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "pending", "needs-review"] },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "severity", "status"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["info", "warning", "error"] },
              "status": { "type": "string", "enum": ["open", "resolved"] },
              "pdfPages": { "$ref": "#/$defs/pageArray" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "relativeMarkdownPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:\\\\|\\.\\.|://))[^\\s]+\\.md$"
    },
    "pageArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
